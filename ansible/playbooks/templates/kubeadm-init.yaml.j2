apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ cluster_api_address }}
  bindPort: 6443
nodeRegistration:
  name: k8s-controller
  criSocket: {{ cluster_cri_socket }}
  kubeletExtraArgs:
    - name: node-ip
      value: {{ cluster_api_address }}
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: {{ cluster_kubernetes_version }}
clusterName: dacn2-lab
networking:
  podSubnet: {{ cluster_pod_cidr }}
  serviceSubnet: {{ cluster_service_cidr }}
  dnsDomain: cluster.local
apiServer:
  certSANs:
    - {{ cluster_api_address }}
